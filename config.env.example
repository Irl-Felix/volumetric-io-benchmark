# MedIOBench configuration (example)
#
# Copy this file to config.env and edit values.
#
#   cp config.env.example config.env

# Input file (set this to your own TIFF)
MEDIOBENCH_TIFF_PATH=/path/to/your/stack.tif

# Logical file size used for GB/s calculations
# Tip: run `python tools/derive_config.py` to auto-fill this and the slice layout.
MEDIOBENCH_FILESIZE_GB=0.0

# Repetitions per benchmark
MEDIOBENCH_N_RUNS=5

# Hardware ceilings (set after running `make baseline`)
MEDIOBENCH_DISK_CEILING_GBS=0.0
MEDIOBENCH_MEM_CEILING_GBS=0.0

# Slice-by-slice layout (only used by *_slice_* benchmarks)
MEDIOBENCH_N_SLICES=0
MEDIOBENCH_SLICE_BYTES=0
MEDIOBENCH_DATA_OFFSET=0